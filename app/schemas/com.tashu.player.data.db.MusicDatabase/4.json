    "views": [
      {
        "viewName": "album_view",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT a.id, a.folderId, a.artworkPath, CASE WHEN s.albumTags = 1 AND s.album <> 'Album inconnu' THEN s.album ELSE f.name END AS title, COALESCE((SELECT t.albumArtist FROM tracks t WHERE t.albumId = a.id GROUP BY t.albumArtist HAVING COUNT(*) * 2 > s.trackCount), 'Artistes divers') AS artistName, s.year, s.trackCount, s.dateAdded, s.playCount, s.lastPlayedAt, s.durationMs FROM albums a JOIN (SELECT albumId, COUNT(*) AS trackCount, COUNT(DISTINCT album) AS albumTags, MIN(album) AS album, MAX(year) AS year, MIN(dateAdded) AS dateAdded, SUM(playCount) AS playCount, MAX(lastPlayedAt) AS lastPlayedAt, SUM(durationMs) AS durationMs FROM tracks GROUP BY albumId) s ON s.albumId = a.id JOIN folders f ON f.id = a.folderId"
      }
    ],
